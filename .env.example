# ─── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/land_acquisition

# JWT — generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend origins allowed for CORS (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Set to false in production
DEBUG=true
